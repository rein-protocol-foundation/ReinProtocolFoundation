<noscript><p style="padding:32px">请启用 JavaScript 以浏览此文件内嵌的邮件模板。</p></noscript>
<script id="email-data" type="application/json">__EMAIL_REVIEW_DATA__</script>
<script>
'use strict';
const {catalog, assets} = JSON.parse(document.getElementById('email-data').textContent);
const groups = [['welcome','欢迎邮件'],['outreach','Outreach · 对外联络'],['transactional','社区业务通知'],['auth','账号安全']];
const byId = (id) => document.getElementById(id);
const frame = byId('preview');
let selected = null;
let observer;
let sizeFrame;
byId('total').textContent = catalog.length;
function element(tag, text, className) { const el=document.createElement(tag); if(text)el.textContent=text; if(className)el.className=className; return el; }
function renderNavigation() {
  const query=byId('search').value.trim().toLocaleLowerCase();
  const matches=catalog.filter(email=>[email.title,email.description,email.subject,email.source,email.status].join(' ').toLocaleLowerCase().includes(query));
  byId('navigation').replaceChildren();
  for(const [key,label] of groups){
    const emails=matches.filter(email=>email.group===key);
    if(!emails.length)continue;
    const section=element('section',null,'nav-group');
    const heading=element('h2',label);heading.append(element('span',String(emails.length)));section.append(heading);
    for(const email of emails){
      const button=element('button',email.title,'template-button');button.type='button';button.dataset.id=email.id;
      if(email.id===selected)button.setAttribute('aria-current','page');
      button.addEventListener('click',()=>selectEmail(email.id));section.append(button);
    }
    byId('navigation').append(section);
  }
  byId('empty').hidden=matches.length>0;
  byId('search-count').textContent=query ? `${matches.length} / ${catalog.length} 个匹配模板` : `${catalog.length} 个模板与变体 · 选择一封开始审阅`;
}
function previewHtml(original){
  let html=original;
  for(const [url,data] of Object.entries(assets))html=html.replaceAll(url,data);
  const policy='<meta http-equiv="Content-Security-Policy" content="default-src \'none\'; img-src data:; style-src \'unsafe-inline\'; base-uri \'none\'; form-action \'none\'">';
  if(/<head[\s>]/i.test(html))return html.replace(/<head[^>]*>/i,match=>match+policy);
  if(/<html[\s>]/i.test(html))return html.replace(/<html[^>]*>/i,match=>match+'<head>'+policy+'</head>');
  return '<!doctype html><html lang="en"><head><meta charset="utf-8">'+policy+'</head><body>'+html+'</body></html>';
}
function selectEmail(id){
  const email=catalog.find(item=>item.id===id)||catalog[0];selected=email.id;
  // Some local-file viewers disallow history updates. Preview rendering must still work.
  try { history.replaceState(null,'','#'+email.id); }
  catch(error) { if(error.name!=='SecurityError')throw error; }
  document.querySelectorAll('.template-button').forEach(button=>{if(button.dataset.id===selected)button.setAttribute('aria-current','page');else button.removeAttribute('aria-current');});
  byId('template-title').textContent=email.title;byId('description').textContent=email.description;byId('subject').textContent=email.subject;
  byId('status').textContent=email.status;byId('status').classList.toggle('pending',email.id==='contributor-welcome');
  byId('source').textContent='来源：'+email.source;
  byId('variables').replaceChildren();
  for(const [key,value] of Object.entries(email.variables))byId('variables').append(element('dt',key),element('dd',value));
  byId('link-target').hidden=true;
  const documentCopy=new DOMParser().parseFromString(email.html,'text/html');
  byId('links').replaceChildren();
  const links=[...documentCopy.querySelectorAll('a[href]')];
  for(const link of links){const row=element('li');row.append(element('strong',link.textContent.trim()||link.querySelector('img')?.alt||'图片链接'),element('code',link.getAttribute('href')));byId('links').append(row);}
  byId('link-count').textContent='('+links.length+')';
  if(observer)observer.disconnect();
  sizeFrame=null;frame.style.height='100px';frame.title=email.title+' 邮件预览';frame.srcdoc=previewHtml(email.html);
}
frame.addEventListener('load',()=>{
  const doc=frame.contentDocument;if(!doc?.body)return;
  sizeFrame=()=>{const style=frame.contentWindow.getComputedStyle(doc.body);const margins=parseFloat(style.marginTop)+parseFloat(style.marginBottom);const height=Math.ceil(Math.max(doc.body.getBoundingClientRect().height,doc.body.scrollHeight)+margins+2);frame.style.height=height+'px';};
  observer=new ResizeObserver(sizeFrame);observer.observe(doc.body);sizeFrame();
  doc.addEventListener('click',event=>{const link=event.target.closest('a');if(link){event.preventDefault();byId('link-target').textContent='链接目标：'+link.getAttribute('href');byId('link-target').hidden=false;}});
  doc.addEventListener('submit',event=>event.preventDefault());
});
function setWidth(mobile){byId('frame-wrap').classList.toggle('mobile',mobile);byId('mobile').setAttribute('aria-pressed',String(mobile));byId('desktop').setAttribute('aria-pressed',String(!mobile));requestAnimationFrame(()=>sizeFrame?.());}
byId('desktop').addEventListener('click',()=>setWidth(false));byId('mobile').addEventListener('click',()=>setWidth(true));
byId('search').addEventListener('input',renderNavigation);
window.addEventListener('hashchange',()=>{const id=location.hash.slice(1);if(catalog.some(email=>email.id===id))selectEmail(id);});
renderNavigation();selectEmail(location.hash.slice(1));
</script>
